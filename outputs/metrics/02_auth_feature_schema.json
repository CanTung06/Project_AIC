{
  "task": "user authentication anomaly detection",
  "target_column": "is_anomaly",
  "source_label_column": "Anomaly",
  "metadata_columns": [
    "event_timestamp",
    "User ID"
  ],
  "categorical_columns": [
    "Login Status"
  ],
  "categorical_encoding": "one-hot Login Status; IP, Location and Device Type are represented by per-user history features",
  "excluded_source_columns": [
    "User ID",
    "IP Address",
    "Location",
    "Device Type"
  ],
  "excluded_from_model_features": [
    "User ID",
    "raw IP Address",
    "raw Location",
    "raw Device Type"
  ],
  "unknown_category_handling": "Unseen IP, Location and Device Type values are retained for per-user history features; unseen Login Status values map to OTHER.",
  "source_attribute_representation": {
    "Timestamp": [
      "login_hour_sin",
      "login_hour_cos",
      "login_weekday_sin",
      "login_weekday_cos"
    ],
    "IP Address": [
      "user_ip_seen_before",
      "user_ip_logins_before",
      "user_distinct_ips_before"
    ],
    "Location": [
      "user_location_seen_before",
      "user_location_logins_before",
      "user_distinct_locations_before"
    ],
    "Device Type": [
      "user_device_seen_before",
      "user_device_logins_before",
      "user_distinct_devices_before"
    ],
    "Login Status": [
      "Login Status__Fail",
      "Login Status__Success"
    ]
  },
  "category_vocabulary": {
    "Login Status": [
      "Fail",
      "Success",
      "__MISSING__",
      "__OTHER__"
    ]
  },
  "feature_columns": [
    "login_hour_sin",
    "login_hour_cos",
    "login_weekday_sin",
    "login_weekday_cos",
    "user_logins_before",
    "seconds_since_previous_login",
    "user_ip_seen_before",
    "user_ip_logins_before",
    "user_distinct_ips_before",
    "user_location_seen_before",
    "user_location_logins_before",
    "user_distinct_locations_before",
    "user_device_seen_before",
    "user_device_logins_before",
    "user_distinct_devices_before",
    "Login Status__Fail",
    "Login Status__Success"
  ],
  "history_features": true,
  "history_features_are_past_only": true,
  "feature_design": "Cyclical timestamp, per-user prior login/IP/location/device history, and one-hot Login Status; raw User ID/IP/Location/Device values excluded"
}